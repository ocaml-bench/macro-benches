; libevent's libdir is resolved at build time (pkg-config, gcc fallback) so this
; links on any multiarch target. Full path to libevent.so rather than -levent:
; dune puts (link_flags) before the C-stub archive on the link line, so a bare
; -levent is dropped before the stubs reference it (--no-as-needed doesn't help).

(rule
 (target devkit_link_flags.sexp)
 (action
  (with-stdout-to devkit_link_flags.sexp
   (system
    "d=$(pkg-config --variable=libdir libevent 2>/dev/null); [ -n \"$d\" ] || d=$(dirname \"$(gcc -print-file-name=libevent.so)\"); printf '(-cclib -Wl,-rpath,%s -cclib %s/libevent.so -cclib -lcurl)' \"$d\" \"$d\""))))

(executable
 (name htmlStream_bench)
 (modules htmlStream_bench)
 (libraries devkit)
 (link_flags (:include devkit_link_flags.sexp)))

(executable
 (name stre_bench)
 (modules stre_bench)
 (libraries devkit)
 (link_flags (:include devkit_link_flags.sexp)))

(executable
 (name network_bench)
 (modules network_bench)
 (libraries devkit)
 (link_flags (:include devkit_link_flags.sexp)))

(executable
 (name gzip_bench)
 (modules gzip_bench)
 (libraries devkit)
 (link_flags (:include devkit_link_flags.sexp)))
