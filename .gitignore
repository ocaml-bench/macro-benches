# Dune build artifacts
_build/
_build-*/

# Vendored sources (populated by scripts/setup-monorepo.sh)
duniverse/
vendor/

# Rocq local install (for coqc stdlib/plugins)
_rocq_prefix/

# Benchmark binaries (executable-mode MMTk names; commit-mode -ocaml-mmtk-* is
# already covered by *-ocaml-*). Narrow patterns so they don't match result dirs
# whose names contain "-mmtk-".
*-ocaml-*
*-oxcaml-*
*-mmtk
*-mmtk-nm
*-ci-timing
# CI artifacts: benchmark binaries/wrappers built under the `ci` runtime tag by
# scripts/ci-build-all.sh, the findlib conf jsoo.build.sh emits per tag, and the
# per-program logs both CI scripts write.
*-ci
findlib-*.conf
ci-logs/

# Coq compilation artifacts (produced by running the coq benchmarks)
benchmarks/coq/*.vo
benchmarks/coq/*.vos
benchmarks/coq/*.vok
benchmarks/coq/*.glob
benchmarks/coq/.*.aux

# Editor / OS
*~
.DS_Store
scripts/.switch-inventory-backup-*.txt

# Generated alt-ergo benchmark inputs (built by alt-ergo.build.sh)
benchmarks/alt-ergo/fill_x*.why

# Generated input for ocamlc_self_compile benchmark
benchmarks/ocamlc-self-compile/inputs/compile_workload.ml

# Notebook execution artifacts (rebuilt on re-run)
results/**/notebooks/cache/
results/**/notebooks/__pycache__/

# goblint run artifacts (witness output + preprocessing cache)
witness.yml
.goblint/
