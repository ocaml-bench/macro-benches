# Dune build artifacts
_build/
_build-*/

# Vendored sources (populated by scripts/setup-monorepo.sh)
duniverse/
vendor/

# Rocq local install (for coqc stdlib/plugins)
_rocq_prefix/

# Benchmark binaries (executable-mode MMTk names; commit-mode -ocaml-mmtk-* is
# already covered by *-ocaml-*). Narrow patterns so they don't match result dirs
# whose names contain "-mmtk-".
*-ocaml-*
*-oxcaml-*
*-mmtk
*-mmtk-nm
*-ci-timing
# CI artifacts: benchmark binaries/wrappers built under the `ci` runtime tag by
# scripts/ci-build-all.sh, the findlib conf jsoo.build.sh emits per tag, and the
# per-program logs both CI scripts write.
*-ci
findlib-*.conf
ci-logs/

# Coq compilation artifacts (produced by running the coq benchmarks)
benchmarks/coq/*.vo
benchmarks/coq/*.vos
benchmarks/coq/*.vok
benchmarks/coq/*.glob
benchmarks/coq/.*.aux

# Editor / OS
*~
.DS_Store
scripts/.switch-inventory-backup-*.txt

# Generated alt-ergo benchmark inputs (built by alt-ergo.build.sh)
benchmarks/alt-ergo/fill_x*.why
benchmarks/alt-ergo/alt_ergo_chain_*.why

# Generated input for ocamlc_self_compile benchmark
benchmarks/ocamlc-self-compile/inputs/compile_workload.ml

# Generated goblint ladder inputs (built by goblint.build.sh)
benchmarks/goblint/goblint_gen_*.c

# Staged uucp sources for ocamlc_compile_uucp (re-copied from duniverse/ on
# every build by ocamlc-compile-uucp.build.sh)
benchmarks/ocamlc-compile-uucp/inputs/uucp*/

# Notebook execution artifacts (rebuilt on re-run)
results/**/notebooks/cache/
results/**/notebooks/__pycache__/

# goblint run artifacts (witness output + preprocessing cache)
witness.yml
.goblint/

# menhir benchmark OUTPUTS, not inputs. menhir_sysver runs
#   menhir -v --table benchmarks/menhir/sysver.mly
# and menhir writes its generated parser and -v reports NEXT TO the grammar, so
# every benchmark run rewrote these and left the tree dirty (~113MB of them,
# with sysver.ml alone at 57MB). Nothing reads them: the only reference to
# `sysver` anywhere outside results/ is the benchmark's own args, which pass
# the .mly. The grammar is the input and stays tracked.
benchmarks/menhir/sysver.ml
benchmarks/menhir/sysver.mli
benchmarks/menhir/sysver.automaton
benchmarks/menhir/sysver.conflicts
