; Hand-written dune file for ocurl (upstream uses autoconf + Makefile).
; config.h was pre-generated by ./configure and ships with the overlay.

(library
 (name curl)
 (public_name curl)
 (wrapped false)
 (modules curl)
 (libraries unix)
 (foreign_stubs
  (language c)
  (names curl-helper)
  (flags (:standard -Wall -DHAVE_CONFIG_H -I/usr/include/x86_64-linux-gnu))
  (extra_deps config.h))
 (c_library_flags (-lcurl)))

(library
 (name curl_lwt)
 (public_name curl.lwt)
 (wrapped false)
 (modules curl_lwt)
 (libraries curl lwt.unix))
